# Backend (src/main.ts). Without DATABASE_URL the API uses in-memory repositories
# (fine for local exploration; data is lost on restart).
DATABASE_URL=postgresql://erp:erp@localhost:5432/enterprise_erp
# HS256 signing key for access tokens, 32+ characters. Use a secret manager in real deployments.
JWT_SECRET=change-me-to-a-long-random-string-0123456789
PORT=3000
SEED_DEMO=true
# LLM: "mock" (default, deterministic, no network, no keys) or "openai-compatible".
# Pointing at an external provider sends prompts — possibly including business data — off-box.
# See docs/SECURITY.md and docs/adr/0002-pluggable-llm.md.
LLM_PROVIDER=mock
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama3.1
